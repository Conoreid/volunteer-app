rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: user documents containing email, password, name, role
    match /users/{userId} {
      allow read, write: if true;
    }

    // Markers: anyone can view markers; can be updated by volunteers
    match /markers/{markerId} {
      allow read, write: if true;
    }

    // Reports: incident reports submitted upon completion
    match /reports/{reportId} {
      allow read, write: if true;
    }
  }
}
